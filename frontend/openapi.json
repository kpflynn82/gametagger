  "components": {
    "schemas": {
      "AssetView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "bytes": {
            "type": "integer",
            "title": "Bytes"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          },
          "duration": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "frames": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Frames"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "sha256",
          "bytes",
          "url"
        ],
        "title": "AssetView"
      },
      "Capabilities": {
        "properties": {
          "environment": {
            "type": "string",
            "title": "Environment",
            "default": "Private local workspace"
          },
          "user": {
            "type": "string",
            "title": "User"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "live_enabled": {
            "type": "boolean",
            "title": "Live Enabled",
            "default": false
          },
          "live_reason": {
            "type": "string",
            "title": "Live Reason",
            "default": "No numeric API budget authorized. Live analysis is disabled."
          },
          "images": {
            "type": "boolean",
            "title": "Images",
            "default": true
          },
          "video": {
            "type": "boolean",
            "title": "Video"
          },
          "video_status": {
            "type": "string",
            "title": "Video Status",
            "default": "Experimental preprocessing; temporal recognition not validated"
          },
          "max_images": {
            "type": "integer",
            "title": "Max Images",
            "default": 8
          },
          "max_image_bytes": {
            "type": "integer",
            "title": "Max Image Bytes",
            "default": 5242880
          },
          "max_video_bytes": {
            "type": "integer",
            "title": "Max Video Bytes",
            "default": 41943040
          },
          "max_video_seconds": {
            "type": "integer",
            "title": "Max Video Seconds",
            "default": 60
          },
          "taxonomy_version": {
            "type": "string",
            "title": "Taxonomy Version",
            "default": "4.1"
          },
          "runtime": {
            "type": "string",
            "title": "Runtime",
            "default": "Local API responding; coding-agent runtime unknown"
          },
          "providers": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Providers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user",
          "role",
          "video",
          "providers"
        ],
        "title": "Capabilities"
      },
      "CatalogPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProjectView"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "CatalogPage"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProjectCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title"
          },
          "release": {
            "type": "string",
            "maxLength": 160,
            "title": "Release",
            "default": "Unspecified release"
          },
          "platform": {
            "type": "string",
            "enum": [
              "pc",
              "console",
              "mobile",
              "multiplatform"
            ],
            "title": "Platform",
            "default": "pc"
